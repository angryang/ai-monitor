    {
      "type": "row",
      "title": "辅助 · ITL · 错误 · 调度",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 35},
      "collapsed": true,
      "id": 103,
      "panels": [
        {
          "type": "timeseries",
          "title": "ITL P95（生成流畅度）",
          "id": 30,
          "gridPos": {"h": 7, "w": 12, "x": 0, "y": 36},
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "targets": [
            {
              "expr": "histogram_quantile(0.95, sum by (le, protocol, model) (rate(ai_probe_itl_seconds_bucket{protocol=~\"$protocol\", model=~\"$model\"}[$__rate_interval])))",
              "legendFormat": "{{protocol}} · {{model}}"
            }
          ],
          "fieldConfig": {"defaults": {"unit": "s", "min": 0}}
        },
        {
          "type": "timeseries",
          "title": "错误率（按协议 + 模型）",
          "id": 31,
          "gridPos": {"h": 7, "w": 12, "x": 12, "y": 36},
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "targets": [
            {
              "expr": "1 - (sum by (protocol, model) (rate(ai_probe_request_total{protocol=~\"$protocol\", model=~\"$model\", status=\"success\"}[5m])) / clamp_min(sum by (protocol, model) (rate(ai_probe_request_total{protocol=~\"$protocol\", model=~\"$model\"}[5m])), 1))",
              "legendFormat": "{{protocol}} · {{model}}"
            }
          ],
          "fieldConfig": {"defaults": {"unit": "percentunit"}}
        },
        {
          "type": "timeseries",
          "title": "失败细分（按 error_type）",
          "id": 32,
          "gridPos": {"h": 7, "w": 12, "x": 0, "y": 43},
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "targets": [
            {
              "expr": "sum by (protocol, model, error_type) (rate(ai_probe_failure_total{protocol=~\"$protocol\", model=~\"$model\"}[5m]))",
              "legendFormat": "{{protocol}} · {{model}} · {{error_type}}"
            }
          ],
          "fieldConfig": {"defaults": {"unit": "short"}}
        },
        {
          "type": "timeseries",
          "title": "调度延迟（schedule lag）",
          "id": 33,
          "gridPos": {"h": 7, "w": 12, "x": 12, "y": 43},
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "targets": [
            {
              "expr": "ai_probe_scheduler_lag_seconds{protocol=~\"$protocol\", model=~\"$model\"}",
              "legendFormat": "{{task_id}}"
            }
          ],
          "fieldConfig": {"defaults": {"unit": "s", "min": 0}}
        },
        {
          "type": "timeseries",
          "title": "Chunk 接收数量",
          "id": 34,
          "gridPos": {"h": 7, "w": 12, "x": 0, "y": 50},
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "targets": [
            {
              "expr": "rate(ai_probe_chunk_total{protocol=~\"$protocol\", model=~\"$model\"}[5m])",
              "legendFormat": "{{protocol}} · {{model}}"
            }
          ],
          "fieldConfig": {"defaults": {"unit": "short"}}
        }
