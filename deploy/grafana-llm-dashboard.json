  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["ai-monitor", "llm", "probe"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus 数据源",
        "type": "datasource",
        "query": "prometheus",
        "current": {"selected": false, "text": "Prometheus", "value": "Prometheus"},
        "hide": 0
      },
      {
        "name": "protocol",
        "label": "协议（渠道）",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "query": {
          "query": "label_values(ai_probe_ttft_seconds_bucket, protocol)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {"selected": false, "text": ["All"], "value": ["$__all"]},
        "multi": true,
        "includeAll": true,
        "refresh": 1
      },
      {
        "name": "model",
        "label": "模型",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "query": {
          "query": "label_values(ai_probe_ttft_seconds_bucket{protocol=~\"$protocol\"}, model)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {"selected": false, "text": ["All"], "value": ["$__all"]},
        "multi": true,
        "includeAll": true,
        "refresh": 1
      }
    ]
  },
