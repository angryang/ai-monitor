{
  "annotations": {
    "list": []
  },
  "description": "AI 服务监控与指标统计系统 · LLM 拨测 · 分位数趋势看板。配套 ai-monitor /metrics 端点使用。详见 docs/design.md。",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "row",
      "title": "概览",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false,
      "id": 100,
      "panels": []
    },
    {
      "type": "stat",
      "title": "活跃任务数",
      "id": 1,
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "count(count by (task_id) (ai_probe_request_total{protocol=~\"$protocol\", model=~\"$model\"}))",
          "legendFormat": "tasks"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "总探测速率（rpm）",
      "id": 2,
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "sum(rate(ai_probe_request_total{protocol=~\"$protocol\", model=~\"$model\"}[5m])) * 60",
          "legendFormat": "rpm"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "stat",
      "title": "成功率（5m）",
      "id": 3,
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "sum(rate(ai_probe_request_total{protocol=~\"$protocol\", model=~\"$model\", status=\"success\"}[5m])) / clamp_min(sum(rate(ai_probe_request_total{protocol=~\"$protocol\", model=~\"$model\"}[5m])), 1)",
          "legendFormat": "success rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.8},
              {"color": "green", "value": 0.95}
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "type": "stat",
      "title": "未恢复的失败任务",
      "id": 4,
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "(count(count by (task_id) (ai_probe_request_total{protocol=~\"$protocol\", model=~\"$model\"})) - count(count by (task_id) (ai_probe_task_last_success_timestamp_seconds{protocol=~\"$protocol\", model=~\"$model\"} > (time() - 600))))",
          "legendFormat": "down"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "type": "row",
      "title": "TTFT 分位数趋势（P50 / P90 / P95 / P99）",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "collapsed": false,
      "id": 101,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "TTFT P50",
      "id": 10,
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, protocol, model) (rate(ai_probe_ttft_seconds_bucket{protocol=~\"$protocol\", model=~\"$model\"}[$__rate_interval])))",
          "legendFormat": "{{protocol}} · {{model}} · P50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 5, "showPoints": "never"},
          "min": 0
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi"}
      }
    },
